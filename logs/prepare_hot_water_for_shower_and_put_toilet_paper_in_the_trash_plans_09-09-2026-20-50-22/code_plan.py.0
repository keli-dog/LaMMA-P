(define (problem prepare_hot_water_problem)
  (:domain robot2)
  (:objects
    robot2 - robot
    faucet - object
    bathtub - object
    counterTop - object
  )
  (:init
    (at robot2 counterTop)
    (at-location faucet counterTop)
    (at-location bathtub counterTop)
    (not (inaction robot2))
    (switch-off robot2 faucet)
  )
  (:goal
    (and
      (switch-on robot2 faucet)
      (at robot2 bathtub)
      (switch-off robot2 faucet)
    )
  )
)

