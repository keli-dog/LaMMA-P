    :duration (= ?duration 1)
    :condition (and (at start (at ?r ?o))
                    (at start (switch-on ?o))
                    (at start (not (inaction ?r))))
    :effect (and (at start (not (inaction ?r)))
                 (at end (switch-off ?o))
                 (at end (not (switch-on ?o)))
                 (at end (not (inaction ?r))))
