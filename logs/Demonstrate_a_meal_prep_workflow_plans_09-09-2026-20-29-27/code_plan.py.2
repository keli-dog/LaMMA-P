# Problem File Extraction for Boil Egg Task

(define (problem handleegg_problem)
  (:domain robot1)
  (:objects
    robot1 - robot
    egg - object
    pot - object
    counterTop - object
    initiallocation - object
  )
  (:init
    (at robot1 initiallocation)
    (at-location egg counterTop)
    (at-location pot counterTop)
    (inaction robot1)
    (not (holding robot1 egg))
  )
  (:goal
    (and
      (at-location egg pot)
      (not (holding robot1 egg))
    )
  )
)

(define (problem boilwater_problem)
  (:domain robot2)
  (:objects
    robot2 - robot
    pot - object
    faucet - object
    stoveBurner - object
    stoveKnob - object
    initiallocation - object
  )
  (:init
    (at robot2 initiallocation)
    (at-location pot counterTop)
    (inaction robot2)
    (not (holding robot2 pot))
    (switch-off robot2 stoveBurner)
  )
  (:goal
    (and
      (switch-on robot2 stoveBurner)
      (at-location pot stoveBurner)
    )
  )
)

